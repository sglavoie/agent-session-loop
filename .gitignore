.DS_Store
__pycache__/
*.py[cod]
*.bak

**/cache/

# Python tooling caches and the local virtualenv; `.cache/` holds the shard
# durations `tests/run_suite.py` schedules longest-first from
.cache/
.venv/
.mypy_cache/
.ruff_cache/

# CodeGraph generates this index locally; it is machine-specific and rebuildable
.codegraph/

# Stray review artifacts an agent turn writes into the checkout. Tracking them
# made every rewrite a diff the supervisor audit's read-only mutation guard
# reports as a workspace mutation.
skills/final-review.json
skills/final-review.md

# The only dependencies are the pinned dev group in pyproject.toml, which CI
# installs with `pip install --group dev`; a uv lock would be a second,
# unchecked record of those versions, so a local one stays untracked
uv.lock

# Claude Code's per-checkout state; `.claude/worktrees/` holds full copies of the
# repository that agents work in.
.claude/
