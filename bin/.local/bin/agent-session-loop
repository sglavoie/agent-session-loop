#!/usr/bin/env python3
"""Repository wrapper for agent_session_loop.cli."""

# Everything above the version guard must still parse on an old interpreter, so
# that `asl` on a stale `python3` prints why it cannot run instead of a
# SyntaxError from deep inside the package.
import sys

if sys.version_info < (3, 14):  # noqa: UP036 - the guard exists for old Pythons
    sys.stderr.write(
        f"asl requires Python 3.14+; found "
        f"{sys.version_info[0]}.{sys.version_info[1]} at {sys.executable}\n"
    )
    raise SystemExit(2)

from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parents[3]
if str(REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(REPO_ROOT))

from agent_session_loop.cli import main  # noqa: E402 - needs REPO_ROOT on sys.path

if __name__ == "__main__":
    raise SystemExit(main())
