  "description": "UTF-8 NDJSON frames on stdio. Protocol 2 keeps every schema-1 shape and adds compatibility identity plus a mutation gate: the hello carries the contract-set ID and declares that mutations require a handshake, and `session.handshake` enables them only against a matching contract set and a snapshot digest the client has actually seen. Snapshots and events are body-free; `question.get` is the one deliberate exception and declares its exemption by pointer below.",
  "forbidden_property_names": [
    "answer",
    "body",
    "initial_prompt",
    "prompt",
    "question_body",
    "question_text",
    "reply",
    "reply_text",
    "text"
  ],
  "max_document_bytes": 1048576,
  "roots": {
    "error_response": "ErrorResponse",
    "handshake_response": "HandshakeResponse",
    "hello": "HelloFrame",
    "operation_receipt_response": "OperationReceiptResponse",
    "operation_updated_event": "OperationUpdatedEvent",
    "question_body_response": "QuestionBodyResponse",
    "recovery_options_response": "RecoveryOptionsResponse",
    "redirect_receipt_response": "RedirectReceiptResponse",
    "redirect_status_response": "RedirectStatusResponse",
    "runs_changed_event": "RunsChangedEvent",
    "runs_snapshot_response": "RunsSnapshotResponse",
    "workbench_link_response": "WorkbenchLinkResponse"
  },
  "title": "ASL bridge protocol 2 frames",
  "version": 2
}
