        "interrupting",
        "stopped",
        "resuming",
        "acknowledged",
        "rejected",
        "blocked",
        "uncertain"
      ]
    },
    "RedirectStatus": {
      "description": "One correction's durable standing, recomputed from the journal rather than remembered. Distinct from `OperationStatus`, which describes a bridge-session receipt: a redirect outlives the session that submitted it, so its status has to survive a restart that the receipt does not.",
