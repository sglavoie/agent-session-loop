{
  "$id": "asl-amx/bridge-protocol-v2",
  "$schema": "https://agent-session-loop.invalid/schemas/asl-amx-contract-1",
  "body_bearing_pointers": [
    "/result/body"
  ],
  "component": "bridge_protocol",
  "definitions": {
    "Action": {
      "description": "What a client may invoke against one row. A superset of `MutationMethod`: `workbench.ensure` changes no ASL state and so needs no handshake, but it is still offered on a row and still has a reason when it is unavailable. Appended to, never reordered -- the action token fingerprints this sequence, so moving an entry invalidates every token in flight.",
      "enum": [
        "question.reply",
        "question.resolve",
        "run.resume",
        "run.stop_after_current",
        "run.abort",
        "workbench.ensure",
        "run.redirect"
      ]
    },
    "Cadence": {
      "additionalProperties": false,
      "description": "How stale the data on the wire can already be. Attached when a snapshot is served rather than when it is built, so it is excluded from the snapshot digest and never moves runs.changed.",
      "properties": {
        "age_seconds": {
          "minimum": 0,
          "type": "number"
        },
        "build_seconds": {
          "minimum": 0,
          "type": "number"
        },
        "failed_projections": {
          "minimum": 0,
          "type": "integer"
        },
        "interval_seconds": {
          "minimum": 0,
          "type": "number"
        },
        "observed_interval_seconds": {
          "minimum": 0,
          "type": "number"
        },
        "staleness_bound_seconds": {
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "age_seconds",
        "build_seconds",
        "failed_projections",
        "interval_seconds",
        "observed_interval_seconds",
        "staleness_bound_seconds"
      ],
      "type": "object"
    },
    "ContextKind": {
      "description": "Why the run is waiting on this question.",
      "enum": [
        "pause",
        "waiting"
      ]
    },
    "ConversationEvidence": {
      "additionalProperties": false,
      "description": "What the conversation ledger can still say about this plan. Carried by both redirect reads because an untrustworthy ledger already forces its own pause, and a correction waiting on the turn that pause prevented is a symptom rather than the problem.",
      "properties": {
        "detail": {
          "maxLength": 400,
          "type": [
            "string",
            "null"
          ]
        },
        "readable": {
          "type": "boolean"
        },
        "records": {
          "minimum": 0,
          "type": "integer"
        },
        "trustworthy": {
          "type": "boolean"
        },
        "unreadable_lines": {
          "minimum": 0,
          "type": "integer"
        },
        "usable": {
          "type": "boolean"
        }
      },
      "required": [
        "detail",
        "readable",
        "records",
        "trustworthy",
        "unreadable_lines",
        "usable"
      ],
      "type": "object"
    },
    "ErrorBody": {
      "additionalProperties": false,
      "description": "A refusal. `message` is bridge-authored and bounded; it is never operator or model prose, which is why it survives the forbidden-name rule.",
      "properties": {
        "code": {
          "$ref": "#/definitions/ErrorCode"
        },
        "details": {
          "additionalProperties": {
            "maxLength": 400,
            "type": "string"
          },
          "propertyNames": {
            "maxLength": 64,
            "type": "string"
          },
          "type": "object"
        },
        "message": {
          "maxLength": 400,
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "details",
        "message",
        "retryable"
      ],
      "type": "object"
    },
    "ErrorCode": {
      "description": "One error space for protocol failures and service-layer refusals. Protocol 2 appends `contract-set-mismatch` and `stale-snapshot`; it removes nothing.",
      "enum": [
        "malformed-json",
        "invalid-request",
        "unsupported-protocol",
        "unknown-method",
        "frame-too-large",
        "internal-error",
        "mutation-failed",
        "workbench-unavailable",
        "invalid-plan",
        "no-active-run",
        "run-mismatch",
        "not-paused",
        "no-open-question",
        "question-mismatch",
        "stale-action-token",
        "action-not-permitted",
        "invalid-action",
        "empty-text",
        "question-body-too-large",
        "missing-question-body",
        "contract-set-mismatch",
        "stale-snapshot"
      ]
    },
    "ErrorResponse": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "$ref": "#/definitions/ErrorBody"
        },
        "id": {
          "$ref": "#/definitions/RequestId"
        },
        "ok": {
          "const": false
        },
        "protocol": {
          "const": 2
        },
        "type": {
          "const": "response"
        }
      },
      "required": [
        "error",
        "id",
        "ok",
        "protocol",
        "type"
      ],
      "type": "object"
    },
    "EventName": {
      "description": "Closed unsolicited-event vocabulary.",
      "enum": [
        "runs.changed",
        "operation.updated"
      ]
    },
    "Focus": {
      "description": "Workbench deep-link panels.",
      "enum": [
        "reply",
        "verification",
        "active",
        "events"
      ]
    },
    "Handshake": {
      "additionalProperties": false,
      "description": "The result of `session.handshake`. Mutations are enabled only when the client's contract-set ID matches and the snapshot digest it names is the one the bridge currently holds.",
      "properties": {
        "contract_set_id": {
          "format": "contract-set-id",
          "type": "string"
        },
        "handshake_id": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "mutations_enabled": {
          "type": "boolean"
        },
        "snapshot_digest": {
          "format": "sha256",
          "type": "string"
        }
      },
      "required": [
        "contract_set_id",
        "handshake_id",
        "mutations_enabled",
        "snapshot_digest"
      ],
      "type": "object"
    },
    "HandshakeResponse": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/definitions/RequestId"
        },
        "ok": {
          "const": true
        },
        "protocol": {
          "const": 2
        },
        "result": {
          "$ref": "#/definitions/Handshake"
        },
        "type": {
          "const": "response"
        }
      },
      "required": [
        "id",
        "ok",
        "protocol",
        "result",
        "type"
      ],
      "type": "object"
    },
    "HelloFrame": {
      "additionalProperties": false,
      "description": "The server-first frame every session begins with. Protocol 2 adds the contract-set ID, the split of methods into readable and mutating, the event list, and the explicit handshake requirement.",
      "properties": {
        "asl_version": {
          "maxLength": 32,
          "type": "string"
        },
        "capabilities": {
          "items": {
            "$ref": "#/definitions/Method"
          },
          "maxItems": 32,
          "type": "array",
          "uniqueItems": true
        },
        "contract_set_id": {
          "format": "contract-set-id",
          "type": "string"
        },
        "events": {
          "items": {
            "$ref": "#/definitions/EventName"
          },
          "maxItems": 16,
          "type": "array",
          "uniqueItems": true
        },
        "handshake_required": {
          "const": true
        },
        "max_frame_bytes": {
          "const": 1048576
        },
        "mutation_methods": {
          "items": {
            "$ref": "#/definitions/MutationMethod"
          },
          "maxItems": 16,
          "type": "array",
          "uniqueItems": true
        },
        "poll_interval_seconds": {
          "minimum": 0,
          "type": "number"
        },
        "protocol": {
          "const": 2
        },
        "type": {
          "const": "hello"
        }
      },
      "required": [
        "asl_version",
        "capabilities",
        "contract_set_id",
        "events",
        "handshake_required",
        "max_frame_bytes",
        "mutation_methods",
        "poll_interval_seconds",
        "protocol",
        "type"
      ],
      "type": "object"
    },
    "Method": {
      "description": "Closed request vocabulary.",
      "enum": [
        "session.handshake",
        "runs.snapshot",
        "question.get",
        "question.reply",
        "question.resolve",
        "run.resume",
        "run.stop_after_current",
        "run.abort",
        "workbench.ensure",
        "run.redirect",
        "run.redirect_status",
        "run.recover_conversation"
      ]
    },
    "MutationMethod": {
      "description": "The subset that changes ASL state. Each requires a completed handshake and a snapshot digest still current when it arrives.",
      "enum": [
        "question.reply",
        "question.resolve",
        "run.resume",
        "run.stop_after_current",
        "run.abort",
        "run.redirect"
      ]
    },
    "Operation": {
      "additionalProperties": false,
      "description": "A body-free receipt for one accepted mutation.",
      "properties": {
        "closure_id": {
          "maxLength": 128,
          "type": [
            "string",
            "null"
          ]
        },
        "command_id": {
          "maxLength": 128,
          "type": [
            "string",
            "null"
          ]
        },
        "detail": {
          "maxLength": 400,
          "type": [
            "string",
            "null"
          ]
        },
        "method": {
          "$ref": "#/definitions/MutationMethod"
        },
        "operation_id": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "plan_dir": {
          "format": "canonical-path",
          "type": "string"
        },
        "question_id": {
          "maxLength": 128,
          "type": [
            "string",
            "null"
          ]
        },
        "row_id": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "run_id": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/OperationStatus"
        }
      },
      "required": [
        "closure_id",
        "command_id",
        "detail",
        "method",
        "operation_id",
        "plan_dir",
        "question_id",
        "row_id",
        "run_id",
        "status"
      ],
      "type": "object"
    },
    "OperationReceiptResponse": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/definitions/RequestId"
        },
        "ok": {
          "const": true
        },
        "protocol": {
          "const": 2
        },
        "result": {
          "$ref": "#/definitions/Operation"
        },
        "type": {
          "const": "response"
        }
      },
      "required": [
        "id",
        "ok",
        "protocol",
        "result",
        "type"
      ],
      "type": "object"
    },
    "OperationStatus": {
      "description": "`accepted` means durable in ASL's own records; every other value is ASL settling the operation by observing its own corpus.",
      "enum": [
        "accepted",
        "consumed",
        "rejected",
        "expired",
        "superseded"
      ]
    },
    "OperationUpdatedEvent": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "$ref": "#/definitions/Operation"
        },
        "event": {
          "const": "operation.updated"
        },
        "protocol": {
          "const": 2
        },
        "seq": {
          "minimum": 1,
          "type": "integer"
        },
        "type": {
          "const": "event"
        }
      },
      "required": [
        "data",
        "event",
        "protocol",
        "seq",
        "type"
      ],
      "type": "object"
    },
    "OwnerLiveness": {
      "description": "Who is still answerable for this plan's redirects, read from the lock alone. `unknown` is a real answer and not an error: every cheaper probe has a side effect on the thing it probes.",
      "enum": [
        "live",
        "gone",
        "unknown"
      ]
    },
    "Question": {
      "additionalProperties": false,
      "description": "Body-free question metadata. Identity, counts, and timing only.",
      "properties": {
        "asked_at": {
          "format": "timestamp",
          "type": [
            "string",
            "null"
          ]
        },
        "context_kind": {
          "$ref": "#/definitions/ContextKind"
        },
        "hard_deadline": {
          "format": "timestamp",
          "type": [
            "string",
            "null"
          ]
        },
        "last_lease_activity_at": {
          "format": "timestamp",
          "type": [
            "string",
            "null"
          ]
        },
        "question_id": {
          "maxLength": 128,
          "type": [
            "string",
            "null"
          ]
        },
        "question_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "type": "array",
          "uniqueItems": true
        },
        "session_id": {
          "maxLength": 64,
          "type": [
            "string",
            "null"
          ]
        },
        "turn_index": {
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "unanswered_count": {
          "minimum": 0,
          "type": "integer"
        },
        "unsupervised_ceiling_seconds": {
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "waiting_status": {
          "maxLength": 64,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "asked_at",
        "context_kind",
        "hard_deadline",
        "last_lease_activity_at",
        "question_id",
        "question_ids",
        "session_id",
        "turn_index",
        "unanswered_count",
        "unsupervised_ceiling_seconds",
        "waiting_status"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "QuestionBodyResponse": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/definitions/RequestId"
        },
        "ok": {
          "const": true
        },
        "protocol": {
          "const": 2
        },
        "result": {
          "$ref": "#/definitions/QuestionBodyResult"
        },
        "type": {
          "const": "response"
        }
      },
      "required": [
        "id",
        "ok",
        "protocol",
        "result",
        "type"
      ],
      "type": "object"
    },
    "QuestionBodyResult": {
      "additionalProperties": false,
      "description": "The one body-bearing result in this contract. It is fetched deliberately, never rides along with a projection, and its exemption from the forbidden-name rule is declared as the pointer `/result/body` rather than inferred.",
      "properties": {
        "action_token": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "body": {
          "maxLength": 262144,
          "type": "string"
        },
        "body_bytes": {
          "maximum": 262144,
          "minimum": 0,
          "type": "integer"
        },
        "context_kind": {
          "$ref": "#/definitions/ContextKind"
        },
        "plan_dir": {
          "format": "canonical-path",
          "type": "string"
        },
        "question_id": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "row_id": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "run_id": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "action_token",
        "body",
        "body_bytes",
        "context_kind",
        "plan_dir",
        "question_id",
        "row_id",
        "run_id"
      ],
      "type": "object"
    },
    "RecoveryDecision": {
      "description": "Which manual recovery a pause is waiting on. Null when the run is not paused, or is paused on something an operator does not decide.",
      "enum": [
        null,
        "fresh-conversation",
        "predecessor-not-stopped"
      ]
    },
    "RecoveryOptions": {
      "additionalProperties": false,
      "description": "Which manual recovery a pause is waiting on and how to authorize it. A report and only a report: performing the recovery through the protocol would persist a one-use authorization in a request that can be replayed. `retained_operations` are the corrections a fresh start would still carry.",
      "properties": {
        "authorization_command": {
          "maxLength": 400,
          "type": [
            "string",
            "null"
          ]
        },
        "authorized_by": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "auto_resume": {
          "type": "boolean"
        },
        "conversations": {
          "$ref": "#/definitions/ConversationEvidence"
        },
        "decision": {
          "$ref": "#/definitions/RecoveryDecision"
        },
        "inspect_command": {
          "maxLength": 400,
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "maxLength": 400,
          "type": [
            "string",
            "null"
          ]
        },
        "one_use": {
          "type": "boolean"
        },
        "pause_reason": {
          "maxLength": 64,
          "type": [
            "string",
            "null"
          ]
        },
        "plan_dir": {
          "format": "canonical-path",
          "type": "string"
        },
        "recovery_required": {
          "type": "boolean"
        },
        "retained_operations": {
          "items": {
            "$ref": "#/definitions/RedirectOperation"
          },
          "maxItems": 64,
          "type": "array"
        },
        "row_id": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "run_id": {
          "maxLength": 128,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "authorization_command",
        "authorized_by",
        "auto_resume",
        "conversations",
        "decision",
        "inspect_command",
        "note",
        "one_use",
        "pause_reason",
        "plan_dir",
        "recovery_required",
        "retained_operations",
        "row_id",
        "run_id"
      ],
      "type": "object"
    },
    "RecoveryOptionsResponse": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/definitions/RequestId"
        },
        "ok": {
          "const": true
        },
        "protocol": {
          "const": 2
        },
        "result": {
          "$ref": "#/definitions/RecoveryOptions"
        },
        "type": {
          "const": "response"
        }
      },
      "required": [
        "id",
        "ok",
        "protocol",
        "result",
        "type"
      ],
      "type": "object"
    },
    "RedirectJournalState": {
      "description": "The last state the append-only journal recorded for a request.",
      "enum": [
        "submitted",
        "accepted",
        "rejected",
        "expired"
      ]
    },
    "RedirectOperation": {
      "additionalProperties": false,
      "description": "One correction as the journal can still describe it after any restart. Body-free by construction: `feedback_digest` and `feedback_bytes` are what let a client prove which correction this is, and the words themselves are reachable only through the journal's own reader.",
      "properties": {
        "continuation": {
          "$ref": "#/definitions/RedirectTarget"
        },
        "continuation_recovered": {
          "type": "boolean"
        },
        "created_at": {
          "format": "timestamp",
          "type": "string"
        },
        "expires_at": {
          "format": "timestamp",
          "type": "string"
        },
        "feedback_bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "feedback_digest": {
          "maxLength": 32,
          "pattern": "[0-9a-f]{32}",
          "type": "string"
        },
        "journal_state": {
          "$ref": "#/definitions/RedirectJournalState"
        },
        "operation_id": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "reason": {
          "$ref": "#/definitions/RedirectReason"
        },
        "stage": {
          "$ref": "#/definitions/RedirectStage"
        },
        "stage_description": {
          "maxLength": 400,
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/RedirectStatus"
        },
        "target": {
          "$ref": "#/definitions/RedirectTarget"
        }
      },
      "required": [
        "continuation",
        "continuation_recovered",
        "created_at",
        "expires_at",
        "feedback_bytes",
        "feedback_digest",
        "journal_state",
        "operation_id",
        "reason",
        "stage",
        "stage_description",
        "status",
        "target"
      ],
      "type": "object"
    },
    "RedirectOutcome": {
      "description": "What this call's submission learned. Null exactly when the call submitted nothing because the journal already held the operation id -- a replay has no outcome of its own, only the durable one it found.",
      "enum": [
        null,
        "accepted",
        "rejected",
        "unavailable",
        "uncertain"
      ]
    },
    "RedirectReason": {
      "description": "Why a correction was refused, or how it settled. Null while it is still in flight and nothing has decided either yet.",
      "enum": [
        null,
        "invalid-plan",
        "no-active-run",
        "run-paused",
        "no-active-turn",
        "stale-target",
        "terminal-audit",
        "remote-owner",
        "stale-lock",
        "urgent-channel-unavailable",
        "expired",
        "run-ended",
        "superseded",
        "operator-cancelled",
        "submitted"
      ]
    },
    "RedirectReceipt": {
      "additionalProperties": false,
      "description": "The answer to one `run.redirect`. `operation` is re-read from the journal rather than built from the submission in hand, so retrying a request whose response was lost returns the same durable record instead of a second correction.",
      "properties": {
        "journal_complete": {
          "type": "boolean"
        },
        "operation": {
          "$ref": "#/definitions/RedirectOperation"
        },
        "operation_id": {
          "maxLength": 128,
          "type": [
            "string",
            "null"
          ]
        },
        "outcome": {
          "$ref": "#/definitions/RedirectOutcome"
        },
        "plan_dir": {
          "format": "canonical-path",
          "type": "string"
        },
        "reason": {
          "$ref": "#/definitions/RedirectReason"
        },
        "replayed": {
          "type": "boolean"
        },
        "row_id": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "run_id": {
          "maxLength": 128,
          "type": [
            "string",
            "null"
          ]
        },
        "target": {
          "$ref": "#/definitions/RedirectTarget"
        },
        "waited_seconds": {
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "journal_complete",
        "operation",
        "operation_id",
        "outcome",
        "plan_dir",
        "reason",
        "replayed",
        "row_id",
        "run_id",
        "target",
        "waited_seconds"
      ],
      "type": "object"
    },
    "RedirectReceiptResponse": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/definitions/RequestId"
        },
        "ok": {
          "const": true
        },
        "protocol": {
          "const": 2
        },
        "result": {
          "$ref": "#/definitions/RedirectReceipt"
