{
  "$id": "asl-amx/lifecycle-hook-v2",
  "$schema": "https://agent-session-loop.invalid/schemas/asl-amx-contract-1",
  "body_bearing_pointers": [],
  "component": "lifecycle_hook",
  "definitions": {
    "Acceptance": {
      "additionalProperties": false,
      "description": "Why a failing verification was nevertheless accepted. Carried as bounded counts and names: the findings themselves stay in the turn artifact.",
      "properties": {
        "accepted": {
          "type": "boolean"
        },
        "deferred_failure_count": {
          "minimum": 0,
          "type": "integer"
        },
        "deferred_failure_names": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "type": "array"
        },
        "reason": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "review_outcome": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "accepted",
        "deferred_failure_count",
        "deferred_failure_names",
        "reason",
        "review_outcome"
      ],
      "type": "object"
    },
    "DeliveryState": {
      "description": "How far the message this event announces has travelled. `consumed` and `unconsumed` say whether a wait ended on a closure the loop took up. `open` and `accepted` are the mailbox spellings: a question nothing has answered yet, and a reply or resolution the mailbox has durably accepted but the waiting loop has not read.",
      "enum": [
        "accepted",
        "consumed",
        "open",
        "unconsumed"
      ]
    },
    "EventName": {
      "description": "Closed lifecycle event vocabulary.",
      "enum": [
        "AgentSessionLoopStarted",
        "AgentSessionLoopTurnStarted",
        "AgentSessionLoopTurnHeartbeat",
        "AgentSessionLoopTurnFinished",
        "AgentSessionLoopTurnHangSuspected",
        "AgentSessionLoopTurnHangCleared",
        "AgentSessionLoopVerificationStarted",
        "AgentSessionLoopVerificationHeartbeat",
        "AgentSessionLoopVerificationFinished",
        "AgentSessionLoopWaitStarted",
        "AgentSessionLoopWaitEnded",
        "AgentSessionLoopMailboxQuestion",
        "AgentSessionLoopMailboxReply",
        "AgentSessionLoopMailboxResolution",
        "AgentSessionLoopPaused",
        "AgentSessionLoopFinished"
      ]
    },
    "HookPayload": {
      "additionalProperties": false,
      "properties": {
        "acceptance": {
          "$ref": "#/definitions/Acceptance"
        },
        "artifact_dir": {
          "format": "canonical-path",
          "type": "string"
        },
        "check_count": {
          "minimum": 0,
          "type": "integer"
        },
        "check_index": {
          "description": "Zero-based position of the check a verification heartbeat is reporting on. A heartbeat that lands between checks reports 0, the same as the first check; `check_name` is what distinguishes them.",
          "minimum": 0,
          "type": "integer"
        },
        "check_kind": {
          "description": "Kind of the check a verification heartbeat is reporting on. Empty when the heartbeat landed between checks.",
          "maxLength": 64,
          "type": "string"
        },
        "check_name": {
          "description": "Name of the check a verification heartbeat is reporting on. Empty when the heartbeat landed between checks.",
          "maxLength": 128,
          "type": "string"
        },
        "closure_consumed": {
          "type": "boolean"
        },
        "closure_id": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "consumed": {
          "description": "Whether the waiting loop has already taken up the mailbox message this event announces. It is false on the mailbox boundaries, which are emitted by the CLI that wrote the message, not by the loop that will read it.",
          "type": "boolean"
        },
        "contract_set_id": {
          "format": "contract-set-id",
          "type": "string"
        },
        "cwd": {
          "format": "canonical-path",
          "type": "string"
        },
        "delivery_state": {
          "$ref": "#/definitions/DeliveryState"
        },
        "diagnostic_count": {
          "description": "Checks that failed without gating the verification.",
          "minimum": 0,
          "type": "integer"
        },
        "emitted_time": {
          "format": "epoch-seconds",
          "type": "string"
        },
        "event": {
          "$ref": "#/definitions/EventName"
        },
        "executed_count": {
          "minimum": 0,
          "type": "integer"
        },
        "gate_count": {
          "description": "Checks whose failure would fail the verification.",
          "minimum": 0,
          "type": "integer"
        },
        "hang_idle_seconds": {
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "hang_reason": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "harness": {
          "maxLength": 64,
          "pattern": "[a-z][a-z0-9_-]{0,63}",
          "type": [
            "string",
            "null"
          ]
        },
        "harness_pid": {
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "heartbeat_count": {
          "minimum": 0,
          "type": "integer"
        },
        "kitty_window_id": {
          "minimum": 1,
          "type": "integer"
        },
        "last_heartbeat_at": {
          "format": "timestamp",
          "type": "string"
        },
        "last_message_path": {
          "format": "canonical-path",
          "type": "string"
        },
        "last_output_at": {
          "format": "timestamp",
          "type": "string"
        },
        "mailbox_projection_sequence": {
          "description": "Generation of the mailbox projection this event was read from. It counts in the mailbox file, not in `source_sequence`'s run-scoped stream, so the two are never comparable.",
          "format": "sequence",
          "type": "string"
        },
        "passed": {
          "type": "boolean"
        },
        "passed_count": {
          "minimum": 0,
          "type": "integer"
        },
        "pause_message": {
          "description": "ASL's own operator-facing pause sentence. It is ASL-authored rather than model-authored, so it is permitted, but it carries a ceiling like every other free-text field in this contract.",
          "maxLength": 500,
          "type": "string"
        },
        "pause_reason": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "phase": {
          "$ref": "#/definitions/Phase"
        },
        "plan_dir": {
          "format": "canonical-path",
          "type": "string"
        },
        "question_created_at": {
          "format": "timestamp",
          "type": "string"
        },
        "question_id": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "question_preview": {
          "description": "The one bounded excerpt this contract permits, and the reason the forbidden-name rule is by name rather than by shape: AgentMux renders it in the dashboard today. It is whitespace-collapsed and capped at 160 characters by the producer, and re-bounded here so a replayed or hand-written payload cannot widen it.",
          "maxLength": 160,
          "type": "string"
        },
        "reason": {
          "$ref": "#/definitions/Reason"
        },
        "resolution_action": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "result_path": {
          "format": "canonical-path",
          "type": "string"
        },
        "run_finished_at": {
          "format": "timestamp",
          "type": "string"
        },
        "run_id": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "run_started_at": {
          "format": "timestamp",
          "type": "string"
        },
        "schema_version": {
          "const": 2
        },
        "session": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "session_id": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "session_number": {
          "minimum": 1,
          "type": "integer"
        },
        "skipped_count": {
          "minimum": 0,
          "type": "integer"
        },
        "source": {
          "const": "agent_session_loop"
        },
        "source_event_id": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "source_sequence": {
          "format": "sequence",
          "type": "string"
        },
        "started_at": {
          "format": "timestamp",
          "type": "string"
        },
        "state_path": {
          "format": "canonical-path",
          "type": "string"
        },
        "stderr_path": {
          "format": "canonical-path",
          "type": "string"
        },
        "stdout_path": {
          "format": "canonical-path",
          "type": "string"
        },
        "total_sessions": {
          "minimum": 1,
          "type": "integer"
        },
        "turn_index": {
          "minimum": 0,
          "type": "integer"
        },
        "unanswered_questions": {
          "minimum": 0,
          "type": "integer"
        },
        "wait_reason": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "contract_set_id",
        "cwd",
        "emitted_time",
        "event",
        "harness",
        "phase",
        "plan_dir",
        "reason",
        "run_id",
        "schema_version",
        "source",
        "source_event_id",
        "source_sequence",
        "state_path"
      ],
      "type": "object"
    },
    "Phase": {
      "description": "The phase this event puts the run in. It is the same vocabulary the projection uses minus `starting`, which no hook announces.",
      "enum": [
        "between",
        "turn",
        "verification",
        "waiting",
        "paused",
        "finished"
      ]
    },
    "Reason": {
      "description": "The snake_case reason paired with the event. It is carried separately because schema-1 consumers key on it.",
      "enum": [
        "run_started",
        "turn_started",
        "turn_heartbeat",
        "turn_finished",
        "turn_hang_suspected",
        "turn_hang_cleared",
        "verification_started",
        "verification_heartbeat",
        "verification_finished",
        "wait_started",
        "wait_ended",
        "mailbox_question_surfaced",
        "mailbox_reply_appended",
        "mailbox_resolution_appended",
        "run_paused",
        "run_finished"
      ]
    }
  },
  "description": "The JSON ASL pipes to `amx hook-indicator` on stdin at every lifecycle boundary. Schema 2 adds the contract-set ID, the explicit event name, and a declared schema version to the schema-1 payload; everything else is the shape ASL already emits, including the verification counters, the turn identity, and the mailbox fields the CLI-emitted boundaries carry. Only the identity fields are required: the rest are event-scoped and appear when the boundary carries them. Sequence and emission time are strings, because a numeric spelling that loses precision in a consumer is worse than a string both ends compare verbatim.",
  "forbidden_property_names": [
    "answer",
    "body",
    "initial_prompt",
    "prompt",
    "question_body",
    "question_text",
    "reply",
    "reply_text",
    "text"
  ],
  "max_document_bytes": 8192,
  "roots": {
    "hook_payload": "HookPayload"
  },
  "title": "ASL lifecycle hook payload, schema 2",
  "version": 2
}
